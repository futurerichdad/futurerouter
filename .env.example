# Copy this file to .env and fill in your keys

# Required: Anthropic API key (console.anthropic.com)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional but recommended: LangSmith tracing/eval (smith.langchain.com, free tier)
# Once set, every graph.invoke() call is automatically traced -- no code changes needed.
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=futurerouter
